<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:orientation="vertical">
    <HorizontalScrollView
        android:id="@+id/stream_filter_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:fadingEdgeLength="16dp"
        android:paddingEnd="12dp"
        android:requiresFadingEdge="horizontal"
        android:scrollbars="none">
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/stream_filter_chip_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            app:singleLine="true"
            app:singleSelection="false">
            <com.google.android.material.chip.Chip
                android:id="@+id/filter_all"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/all" />
            <com.google.android.material.chip.Chip
                android:id="@+id/filter_live"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/channel_tab_livestreams" />
            <com.google.android.material.chip.Chip
                android:id="@+id/filter_videos"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/videos_string" />
            <com.google.android.material.chip.Chip
                android:id="@+id/filter_audio"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/audio"
                android:visibility="gone" />
            <com.google.android.material.chip.Chip
                android:id="@+id/filter_live_audio"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/history_filter_live_audio"
                android:visibility="gone" />
            <com.google.android.material.chip.Chip
                android:id="@+id/filter_post_live_video"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/history_filter_post_live_video"
                android:visibility="gone" />
            <com.google.android.material.chip.Chip
                android:id="@+id/filter_post_live_audio"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/history_filter_post_live_audio"
                android:visibility="gone" />
            <com.google.android.material.chip.Chip
                android:id="@+id/filter_tracks"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/history_filter_tracks"
                android:visibility="gone" />
            <com.google.android.material.chip.Chip
                android:id="@+id/filter_podcasts"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/history_filter_podcasts"
                android:visibility="gone" />
            <com.google.android.material.chip.Chip
                android:id="@+id/filter_courses"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/history_filter_courses"
                android:visibility="gone" />
            <com.google.android.material.chip.Chip
                android:id="@+id/filter_shorts"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/channel_tab_shorts" />
            <com.google.android.material.chip.Chip
                android:id="@+id/filter_upcoming"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/feed_show_upcoming" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>
    <HorizontalScrollView
        android:id="@+id/watch_filter_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:fadingEdgeLength="16dp"
        android:paddingEnd="12dp"
        android:requiresFadingEdge="horizontal"
        android:scrollbars="none">
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/watch_filter_chip_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            app:singleLine="true"
            app:singleSelection="false">
            <com.google.android.material.chip.Chip
                android:id="@+id/filter_watch_all"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/all" />
            <com.google.android.material.chip.Chip
                android:id="@+id/filter_unwatched"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/filter_unwatched" />
            <com.google.android.material.chip.Chip
                android:id="@+id/filter_partially_watched"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/filter_in_progress" />
            <com.google.android.material.chip.Chip
                android:id="@+id/filter_watched"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/feed_show_watched" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>
    <org.schabi.newpipe.views.CompactPlaylistControlsLayout
        android:id="@+id/stream_filter_downloaded_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <HorizontalScrollView
            android:id="@+id/filter_downloaded_scroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingEnd="12dp"
            android:scrollbars="none">
            <com.google.android.material.chip.Chip
                android:id="@+id/filter_downloaded"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:checkable="true"
                android:text="@string/filter_downloaded_only" />
        </HorizontalScrollView>
        <LinearLayout
            android:id="@+id/local_playlist_edit_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="4dp"
            android:orientation="horizontal"
            android:visibility="gone">
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/playlist_edit_toggle"
                style="@style/Widget.WizeStream.CompactPlaylistAction"
                android:contentDescription="@string/playlist_edit_mode"
                app:srcCompat="@drawable/ic_edit" />
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/collection_select_move"
                style="@style/Widget.WizeStream.CompactPlaylistAction"
                android:contentDescription="@string/playlist_select_items"
                app:srcCompat="@drawable/ic_checklist" />
        </LinearLayout>
    </org.schabi.newpipe.views.CompactPlaylistControlsLayout>
</LinearLayout>
