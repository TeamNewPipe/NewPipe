<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface">

    <RelativeLayout
        android:id="@+id/item_bkg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="2dp"
        android:background="?attr/colorSurfaceVariant">

        <ImageView
            android:id="@+id/item_icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="TODO"
            android:gravity="center"
            android:padding="15dp"
            android:scaleType="fitXY"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/item_caption_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/item_icon"
            android:layout_alignEnd="@id/item_icon"
            android:background="?attr/colorPrimaryContainer"
            android:paddingHorizontal="4dp"
            android:paddingVertical="2dp"
            android:text="@string/download_has_captions_badge"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/item_chat_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@id/item_icon"
            android:layout_alignStart="@id/item_icon"
            android:background="?attr/colorSecondaryContainer"
            android:paddingHorizontal="4dp"
            android:paddingVertical="2dp"
            android:text="@string/live_chat_saved_badge"
            android:textColor="?attr/colorOnSecondaryContainer"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/item_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@+id/item_more"
            android:layout_toEndOf="@id/item_icon"
            android:ellipsize="end"
            android:padding="6dp"
            android:text="XXX.xx"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/item_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/item_name"
            android:layout_toEndOf="@id/item_icon"
            android:padding="6dp"
            android:singleLine="true"
            android:text="100.00MB"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/item_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/item_name"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="5dp"
            android:layout_toStartOf="@+id/item_more"
            android:layout_toEndOf="@id/item_size"
            android:padding="6dp"
            android:singleLine="true"
            android:text="0%"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            android:textStyle="bold" />

        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/item_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/item_name"
            android:layout_toStartOf="@id/item_more"
            android:padding="6dp"
            android:singleLine="true"
            android:text=""
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/item_more"
            style="?attr/buttonBarButtonStyle"
            android:layout_width="49dp"
            android:layout_height="49dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="4dp"
            android:contentDescription="TODO"
            android:scaleType="centerInside"
            android:src="@drawable/ic_more_vert"
            app:tint="?attr/colorOnSurfaceVariant" />

    </RelativeLayout>

</RelativeLayout>
