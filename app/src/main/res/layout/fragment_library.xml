<?xml version="1.0" encoding="utf-8"?>
<!-- YewPlay: Biblioteca, que reúne tudo o que é do usuário -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/yp_library_history"
        layout="@layout/yp_library_row" />

    <include
        android:id="@+id/yp_library_downloads"
        layout="@layout/yp_library_row" />

    <include
        android:id="@+id/yp_library_about"
        layout="@layout/yp_library_row" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/yp_screen_margin"
        android:paddingTop="20dp"
        android:paddingBottom="4dp"
        android:text="@string/yp_library_your_playlists"
        android:textAppearance="@style/TextAppearance.YewPlay.SectionTitle"
        android:fontFamily="@font/bricolage_grotesque_bold"
        app:fontFamily="@font/bricolage_grotesque_bold" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/yp_library_playlists"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
