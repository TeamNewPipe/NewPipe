<?xml version="1.0" encoding="utf-8"?>
<!-- YewPlay: atalho da Biblioteca (ícone, rótulo e seta) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/yp_screen_margin">

    <ImageView
        android:id="@+id/yp_row_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no"
        app:tint="@color/yp_on_bg"
        tools:src="@drawable/ic_history" />

    <TextView
        android:id="@+id/yp_row_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.YewPlay.ItemTitle"
        android:fontFamily="@font/instrument_sans_semibold"
        tools:text="Histórico" />

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:importantForAccessibility="no"
        android:src="@drawable/yp_ic_caret_right"
        app:tint="@color/yp_muted" />
</LinearLayout>
