<?xml version="1.0" encoding="utf-8"?>
<!-- YewPlay: canal em destaque no topo da busca (proposta, p. 13) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/itemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/yp_screen_margin"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/yp_featured_card"
    android:clickable="true"
    android:focusable="true"
    android:padding="16dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/itemThumbnailView"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/placeholder_person"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearance="@style/CircularImageView" />

    <TextView
        android:id="@+id/itemTitleView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:ellipsize="end"
        android:fontFamily="@font/bricolage_grotesque_bold"
        android:lines="1"
        android:textColor="@color/yp_on_bg"
        android:textSize="20sp"
        app:fontFamily="@font/bricolage_grotesque_bold"
        app:layout_constraintBottom_toTopOf="@+id/itemAdditionalDetails"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/itemThumbnailView"
        app:layout_constraintTop_toTopOf="@+id/itemThumbnailView"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="Channel Title" />

    <TextView
        android:id="@+id/itemAdditionalDetails"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:lines="1"
        android:textAppearance="@style/TextAppearance.YewPlay.Meta"
        app:layout_constraintBottom_toBottomOf="@+id/itemThumbnailView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/itemTitleView"
        app:layout_constraintTop_toBottomOf="@+id/itemTitleView"
        tools:text="10M subscribers • 1000 videos" />

    <TextView
        android:id="@+id/itemChannelDescriptionView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.YewPlay.Meta"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/itemThumbnailView"
        tools:text="Channel description, Lorem ipsum dolor sit amet" />

    <TextView
        android:id="@+id/yp_channel_subscribe"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/yp_button_primary"
        android:fontFamily="@font/instrument_sans_semibold"
        android:gravity="center"
        android:text="@string/subscribe_button_title"
        android:textColor="@color/yp_on_action"
        android:textSize="14sp"
        android:visibility="gone"
        app:fontFamily="@font/instrument_sans_semibold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/itemChannelDescriptionView"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
