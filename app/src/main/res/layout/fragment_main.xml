<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <org.schabi.newpipe.views.ScrollableTabLayout
        android:id="@+id/main_tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="?attr/colorPrimary"
        app:tabGravity="fill"
        app:tabMode="scrollable"
        app:tabMinWidth="48dp"
        app:tabTextAppearance="@style/TextAppearance.YewPlay.Tab"
        app:tabSelectedTextColor="@color/yp_on_bg"
        app:tabTextColor="@color/yp_muted"
        app:tabPaddingStart="12dp"
        app:tabPaddingEnd="12dp" />

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/main_tab_layout" />

</RelativeLayout>
