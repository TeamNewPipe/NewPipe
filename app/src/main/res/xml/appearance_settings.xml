<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/settings_category_appearance_title">

    <ListPreference
        android:key="launcher_icon"
        android:title="@string/launcher_icon_title"
        android:entries="@array/launcher_icon_labels"
        android:entryValues="@array/launcher_icon_values"
        android:persistent="false"
        app:useSimpleSummaryProvider="true"
        app:iconSpaceReserved="false" />

    <Preference
        android:key="theme_packs"
        android:title="@string/theme_packs_title"
        android:summary="@string/theme_packs_summary"
        android:fragment="org.schabi.newpipe.settings.ThemePackSettingsFragment"
        app:iconSpaceReserved="false" />

    <Preference
        android:key="@string/app_font_key"
        android:title="@string/app_font_title"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <ListPreference
        android:defaultValue="@string/default_theme_value"
        android:entries="@array/theme_description_list"
        android:entryValues="@array/theme_values_list"
        android:key="@string/theme_key"
        android:title="@string/theme_title"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false"
        app:useSimpleSummaryProvider="true" />

    <ListPreference
        android:defaultValue="@string/default_night_theme_value"
        android:entries="@array/night_theme_description_list"
        android:entryValues="@array/night_theme_values_list"
        android:key="@string/night_theme_key"
        android:summary="@string/night_theme_summary"
        android:title="@string/night_theme_title"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <ListPreference
        android:defaultValue="@string/default_theme_color_value"
        android:entries="@array/theme_color_description_list"
        android:entryValues="@array/theme_color_values_list"
        android:key="@string/theme_color_key"
        android:summary="@string/theme_color_summary"
        android:title="@string/theme_color_title"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false"
        app:useSimpleSummaryProvider="true" />

    <EditTextPreference
        android:defaultValue="@string/custom_theme_color_default"
        android:key="@string/custom_theme_color_key"
        android:summary="@string/custom_theme_color_summary"
        android:title="@string/custom_theme_color_title"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <SwitchPreferenceCompat
        android:defaultValue="true"
        android:key="@string/show_hold_to_append_key"
        android:summary="@string/show_hold_to_append_summary"
        android:title="@string/show_hold_to_append_title"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
        android:defaultValue="true"
        android:key="@string/rounded_mini_player_key"
        android:title="@string/rounded_mini_player_title"
        android:summary="@string/rounded_mini_player_summary"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:key="@string/bottom_player_controls_key"
        android:title="@string/bottom_player_controls_title"
        android:summary="@string/bottom_player_controls_summary"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <ListPreference
        android:defaultValue="@string/tablet_mode_auto_key"
        android:entries="@array/tablet_mode_description"
        android:entryValues="@array/tablet_mode_values"
        android:key="@string/tablet_mode_key"
        android:title="@string/tablet_mode_title"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false"
        app:useSimpleSummaryProvider="true" />

    <ListPreference
        android:defaultValue="@string/list_view_mode_value"
        android:entries="@array/list_view_mode_description"
        android:entryValues="@array/list_view_mode_values"
        android:key="@string/list_view_mode_key"
        android:title="@string/list_view_mode"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false"
        app:useSimpleSummaryProvider="true" />

    <ListPreference
        android:defaultValue="@string/grid_columns_auto_key"
        android:entries="@array/grid_columns_description"
        android:entryValues="@array/grid_columns_values"
        android:key="@string/grid_columns_key"
        android:title="@string/grid_columns_title"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false"
        app:useSimpleSummaryProvider="true" />

    <ListPreference
        android:defaultValue="@string/orientation_default_key"
        android:entries="@array/orientation_list_view_mode_description"
        android:entryValues="@array/orientation_list_view_mode_values"
        android:key="@string/list_view_mode_portrait_key"
        android:title="@string/portrait_video_layout"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false"
        app:useSimpleSummaryProvider="true" />

    <ListPreference
        android:defaultValue="@string/orientation_default_key"
        android:entries="@array/orientation_list_view_mode_description"
        android:entryValues="@array/orientation_list_view_mode_values"
        android:key="@string/list_view_mode_landscape_key"
        android:title="@string/landscape_video_layout"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false"
        app:useSimpleSummaryProvider="true" />

    <ListPreference
        android:defaultValue="@string/orientation_default_key"
        android:entries="@array/orientation_grid_columns_description"
        android:entryValues="@array/orientation_grid_columns_values"
        android:key="@string/grid_columns_portrait_key"
        android:title="@string/portrait_grid_columns"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false"
        app:useSimpleSummaryProvider="true" />

    <ListPreference
        android:defaultValue="@string/orientation_default_key"
        android:entries="@array/orientation_grid_columns_description"
        android:entryValues="@array/orientation_grid_columns_values"
        android:key="@string/grid_columns_landscape_key"
        android:title="@string/landscape_grid_columns"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false"
        app:useSimpleSummaryProvider="true" />

    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:key="@string/show_full_grid_titles_key"
        android:summary="@string/show_full_grid_titles_summary"
        android:title="@string/show_full_grid_titles_title"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:key="@string/compact_large_screen_navigation_key"
        android:summary="@string/compact_large_screen_navigation_summary"
        android:title="@string/compact_large_screen_navigation_title"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <ListPreference
        android:defaultValue="@string/comment_text_size_medium_key"
        android:entries="@array/comment_text_size_description"
        android:entryValues="@array/comment_text_size_values"
        android:key="@string/comment_text_size_key"
        android:title="@string/comment_text_size_title"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false"
        app:useSimpleSummaryProvider="true" />

    <ListPreference
        android:defaultValue="100"
        android:entries="@array/media_text_size_description"
        android:entryValues="@array/media_text_size_values"
        android:key="@string/video_title_text_size_key"
        android:title="@string/video_title_text_size_title"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false"
        app:useSimpleSummaryProvider="true" />

    <ListPreference
        android:defaultValue="100"
        android:entries="@array/media_text_size_description"
        android:entryValues="@array/media_text_size_values"
        android:key="@string/channel_name_text_size_key"
        android:title="@string/channel_name_text_size_title"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false"
        app:useSimpleSummaryProvider="true" />

    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:key="@string/scroll_subscription_names_key"
        android:title="@string/scroll_subscription_names_title"
        android:summary="@string/scroll_subscription_names_summary"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
        android:defaultValue="true"
        android:key="@string/show_list_scrollbar_key"
        android:title="@string/show_list_scrollbar_title"
        android:summary="@string/show_list_scrollbar_summary"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <ListPreference
        android:defaultValue="100"
        android:entries="@array/media_text_size_description"
        android:entryValues="@array/media_text_size_values"
        android:key="@string/video_metadata_text_size_key"
        android:title="@string/video_metadata_text_size_title"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false"
        app:useSimpleSummaryProvider="true" />

    <ListPreference
        android:defaultValue="compact"
        android:entries="@array/tv_related_sidebar_width_description"
        android:entryValues="@array/tv_related_sidebar_width_values"
        android:key="@string/tv_related_sidebar_width_key"
        android:title="@string/tv_related_sidebar_width_title"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false"
        app:useSimpleSummaryProvider="true" />

    <Preference
        android:key="@string/caption_settings_key"
        android:summary="@string/caption_setting_description"
        android:title="@string/caption_setting_title"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
        android:defaultValue="true"
        android:key="@string/show_local_like_controls_key"
        android:summary="@string/show_local_like_controls_summary"
        android:title="@string/show_local_like_controls_title"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
        android:defaultValue="true"
        android:key="@string/show_dislike_key"
        android:summary="@string/show_dislikes_summary"
        android:title="@string/show_dislikes_title"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
        android:defaultValue="true"
        android:key="@string/main_tabs_position_key"
        android:summary="@string/main_tabs_position_summary"
        android:title="@string/main_tabs_position_title"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
        android:defaultValue="true"
        android:key="@string/show_service_sections_key"
        android:summary="@string/show_service_sections_summary"
        android:title="@string/show_service_sections_title"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <ListPreference
        android:defaultValue="@string/tablet_navigation_position_default_value"
        android:entries="@array/tablet_navigation_position_description"
        android:entryValues="@array/tablet_navigation_position_values"
        android:key="@string/tablet_navigation_portrait_position_key"
        android:title="@string/tablet_navigation_portrait_position_title"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false"
        app:useSimpleSummaryProvider="true" />

    <ListPreference
        android:defaultValue="@string/tablet_navigation_position_default_value"
        android:entries="@array/tablet_navigation_position_description"
        android:entryValues="@array/tablet_navigation_position_values"
        android:key="@string/tablet_navigation_landscape_position_key"
        android:title="@string/tablet_navigation_landscape_position_title"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false"
        app:useSimpleSummaryProvider="true" />

    <ListPreference
        android:defaultValue="@string/bottom_navigation_labels_default_value"
        android:entries="@array/bottom_navigation_labels_description"
        android:entryValues="@array/bottom_navigation_labels_values"
        android:key="@string/bottom_navigation_labels_key"
        android:title="@string/bottom_navigation_labels_title"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false"
        app:useSimpleSummaryProvider="true" />

    <SwitchPreferenceCompat
        android:key="@string/bold_media_text_key"
        android:defaultValue="false"
        android:title="@string/bold_media_text_title"
        android:summary="@string/bold_media_text_summary"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />
</PreferenceScreen>
