<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/settings_category_device_sync_title">

    <Preference
        android:key="@string/device_sync_status_key"
        android:title="@string/device_sync_status_title"
        app:iconSpaceReserved="false"
        app:selectable="false"
        app:singleLineTitle="false" />

    <Preference
        android:title="@string/sync_vpn_help_title"
        android:summary="@string/sync_vpn_help_summary"
        android:selectable="false"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <Preference
        android:key="@string/device_sync_sync_now_key"
        android:summary="@string/device_sync_sync_now_summary"
        android:title="@string/device_sync_sync_now_title"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <Preference
        android:key="@string/device_sync_log_key"
        android:summary="@string/device_sync_log_empty"
        android:title="@string/device_sync_log_title"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <SwitchPreferenceCompat
        android:defaultValue="true"
        android:key="@string/device_sync_background_key"
        android:summary="@string/device_sync_background_summary"
        android:title="@string/device_sync_background_title"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:key="@string/device_sync_remote_playback_key"
        android:title="@string/device_cast_receiver_title"
        android:summary="@string/device_cast_receiver_summary"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:dependency="@string/device_sync_background_key"
        android:key="@string/device_sync_charging_key"
        android:summary="@string/device_sync_charging_summary"
        android:title="@string/device_sync_charging_title"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <PreferenceCategory
        android:layout="@layout/settings_category_header_layout"
        android:title="@string/device_sync_categories_title">

        <Preference
            android:summary="@string/device_sync_profiles_required_summary"
            android:title="@string/device_sync_category_profiles"
            app:iconSpaceReserved="false"
            app:selectable="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="@string/device_sync_subscriptions_key"
            android:title="@string/device_sync_category_subscriptions"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="@string/device_sync_playlists_key"
            android:title="@string/device_sync_category_playlists"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="@string/device_sync_watch_history_key"
            android:summary="@string/device_sync_watch_history_summary"
            android:title="@string/device_sync_category_watch_history"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="@string/device_sync_search_history_key"
            android:summary="@string/device_sync_search_history_summary"
            android:title="@string/device_sync_search_history_title"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="@string/device_sync_learning_notes_key"
            android:summary="@string/device_sync_learning_notes_summary"
            android:title="@string/device_sync_learning_notes_title"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="@string/device_sync_feed_groups_key"
            android:title="@string/device_sync_category_feed_groups"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="@string/device_sync_home_tabs_key"
            android:title="@string/device_sync_category_home_tabs"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="@string/device_sync_channel_profiles_key"
            android:title="@string/device_sync_category_channel_profiles"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="@string/device_sync_filters_key"
            android:title="@string/device_sync_category_filters"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="@string/device_sync_content_blocking_key"
            android:title="@string/device_sync_category_blocked_content"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="@string/device_sync_settings_key"
            android:title="@string/device_sync_category_settings"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="@string/device_sync_completed_downloads_key"
            android:title="@string/device_sync_category_completed_downloads"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />
    </PreferenceCategory>

    <Preference
        android:key="@string/device_sync_identity_key"
        android:selectable="false"
        android:title="@string/device_sync_identity_title"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <Preference
        android:key="@string/device_sync_show_code_key"
        android:summary="@string/device_sync_show_code_summary"
        android:title="@string/device_sync_show_code_title"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <Preference
        android:key="@string/device_sync_scan_code_key"
        android:summary="@string/device_sync_scan_code_summary"
        android:title="@string/device_sync_scan_code_title"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <PreferenceCategory
        android:key="@string/device_sync_trusted_devices_category_key"
        android:layout="@layout/settings_category_header_layout"
        android:title="@string/device_sync_trusted_devices_title" />

    <Preference
        android:key="@string/device_sync_clear_devices_key"
        android:summary="@string/device_sync_clear_devices_summary"
        android:title="@string/device_sync_clear_devices_title"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />
</PreferenceScreen>
