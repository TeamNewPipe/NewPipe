<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- YewPlay: os estilos por serviço continuam existindo (o código os escolhe pelo nome),
         mas não mudam mais as cores. O app tem uma só paleta para todos os serviços. -->
