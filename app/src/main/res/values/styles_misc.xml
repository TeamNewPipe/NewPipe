<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Follows service's primary color -->
    <style name="ServiceColoredButton" parent="Widget.AppCompat.Button.Colored">
        <item name="colorButtonNormal">?attr/colorPrimary</item>
        <item name="android:textColor">@color/subscribe_text_color</item>
        <item name="colorControlHighlight">@color/dark_ripple_color</item>
    </style>

    <style name="EmptyStateKaomoji">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="MaterialStateActionButton" parent="Widget.AppCompat.Button.Borderless.Colored">
        <item name="colorAccent">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="colorControlHighlight">?attr/colorControlHighlight</item>
    </style>

    <style name="MaterialStateProgressIndicator" parent="Widget.AppCompat.ProgressBar">
        <item name="android:indeterminateTint">?attr/colorPrimary</item>
        <item name="android:progressTint">?attr/colorPrimary</item>
    </style>

    <style name="MaterialStateHorizontalProgressIndicator" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:indeterminateTint">?attr/colorPrimary</item>
        <item name="android:progressTint">?attr/colorPrimary</item>
    </style>

    <style name="Widget.NewPipeMaterial.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">?attr/colorSurfaceInverse</item>
        <item name="shapeAppearance">@style/ShapeAppearance.NewPipeMaterial.Snackbar</item>
        <item name="elevation">6dp</item>
    </style>

    <style name="Widget.NewPipeMaterial.Snackbar.TextView"
        parent="Widget.Material3.Snackbar.TextView">
        <item name="android:textColor">?attr/colorOnSurfaceInverse</item>
    </style>

    <style name="Widget.NewPipeMaterial.Button.TextButton.Snackbar"
        parent="Widget.Material3.Button.TextButton.Snackbar">
        <item name="android:textColor">?attr/colorPrimaryInverse</item>
    </style>

    <style name="ShapeAppearance.NewPipeMaterial.Snackbar" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="PlaybackParameterSeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:thumbTint">?attr/colorPrimary</item>
        <item name="android:progressTint">?attr/colorPrimary</item>
        <item name="android:progressBackgroundTint">?attr/colorSurfaceVariant</item>
        <item name="android:secondaryProgressTint">?attr/colorPrimaryContainer</item>
    </style>


    <!--File picker styles-->
    <style name="FilePickerThemeLight" parent="NNF_BaseTheme.Light">
        <item name="colorPrimary">@color/light_youtube_primary_color</item>
        <item name="colorPrimaryDark">@color/light_youtube_primary_color</item>
        <item name="colorAccent">@color/light_settings_accent_color</item>

        <item name="actionColor">@color/white</item>
        <item name="nnf_toolbarTheme">@style/ToolbarTheme</item>

        <item name="android:windowBackground">@color/light_background_color</item>
        <item name="nnf_separator_color">@color/light_separator_color</item>

        <item name="alertDialogTheme">@style/FilePickerAlertDialogThemeLight</item>
    </style>

    <style name="FilePickerThemeDark" parent="NNF_BaseTheme">
        <item name="colorPrimary">@color/dark_youtube_primary_color</item>
        <item name="colorPrimaryDark">@color/dark_youtube_primary_color</item>
        <item name="colorAccent">@color/dark_settings_accent_color</item>

        <item name="actionColor">@color/white</item>
        <item name="nnf_toolbarTheme">@style/ToolbarTheme</item>

        <item name="android:windowBackground">@color/dark_background_color</item>
        <item name="nnf_separator_color">@color/black_separator_color</item>

        <item name="alertDialogTheme">@style/FilePickerAlertDialogThemeDark</item>
    </style>

    <style name="FilePickerAlertDialogThemeLight" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="colorPrimary">@color/light_youtube_primary_color</item>
        <item name="colorPrimaryDark">@color/light_youtube_primary_color</item>
        <item name="colorAccent">@color/light_settings_accent_color</item>
    </style>

    <style name="FilePickerAlertDialogThemeDark" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="colorPrimary">@color/dark_youtube_primary_color</item>
        <item name="colorPrimaryDark">@color/dark_youtube_primary_color</item>
        <item name="colorAccent">@color/dark_settings_accent_color</item>
    </style>

    <style name="PlayQueueItemTextTheme">
        <item name="android:textAppearanceLarge">@style/PlayQueueItemTitle</item>
        <item name="android:textAppearanceSmall">@style/PlayQueueItemSubtitle</item>
    </style>

    <style name="PlayQueueItemTitle" parent="TextAppearance.AppCompat.Large">
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="PlayQueueItemSubtitle" parent="TextAppearance.AppCompat.Small">
        <item name="android:textColor">@color/white_secondary</item>
    </style>

    <style name="FloatingActionButtonTheme" parent="Widget.Design.FloatingActionButton">
        <item name="tint">?attr/actionColor</item>
    </style>

    <style name="DarkPopupMenu" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="ToolbarTheme" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="popupTheme">@style/ToolbarPopupTheme</item>
        <item name="android:textColorPrimary">?attr/actionColor</item>
        <item name="android:textColorSecondary">?attr/actionColor</item>
        <item name="tint">?attr/actionColor</item>
        <item name="iconTint">?attr/actionColor</item>
    </style>
    <style name="ToolbarPopupTheme" parent="ThemeOverlay.AppCompat.DayNight.ActionBar">
        <item name="tint">@color/contrastColor</item>
    </style>
    <style name="ContrastToolbarTheme" parent="ThemeOverlay.AppCompat.DayNight.ActionBar">
        <item name="popupTheme">@style/ToolbarPopupTheme</item>
        <item name="android:textColorPrimary">@color/contrastColor</item>
        <item name="android:textColorSecondary">@color/contrastColor</item>
        <item name="tint">@color/contrastColor</item>
        <item name="iconTint">@color/contrastColor</item>
        <item name="toolbarSearchColor">@color/contrastColor</item>
    </style>

    <style name="WhiteTintTheme">
        <item name="tint">@color/white</item>
        <item name="iconTint">@color/white</item>
    </style>
    <style name="ContrastTintTheme">
        <item name="tint">@color/contrastColor</item>
        <item name="iconTint">@color/contrastColor</item>
    </style>

    <style name="ToolbarSearchInputTheme">
        <item name="colorPrimary">?attr/colorPrimary</item>
        <item name="colorPrimaryDark">?attr/colorPrimary</item>
        <item name="colorAccent">?attr/colorPrimary</item>
        <item name="colorControlActivated">?attr/colorPrimary</item>
    </style>

    <style name="SearchSuggestionTheme">
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="tint">?attr/colorOnSurfaceVariant</item>
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
        <item name="colorControlHighlight">?attr/colorControlHighlight</item>
    </style>


    <style name="VideoDetailActionText">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:drawableTint">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="CircularImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>
