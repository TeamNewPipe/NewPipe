<resources>

    <!-- Base NewPipe Android TV Theme -->
    <style name="Theme.NewPipe.Tv" parent="Theme.Leanback">
        <item name="defaultBrandColor">#E62117</item>
        <item name="defaultSearchColor">#E62117</item>
        <item name="defaultSearchBrightColor">@color/white</item>
        <item name="defaultSectionHeaderColor">@color/white</item>
        <item name="playbackProgressPrimaryColor">#E62117</item>
        <item name="playbackControlsIconHighlightColor">#E62117</item>
