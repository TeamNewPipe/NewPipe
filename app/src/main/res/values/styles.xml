    </style>

    <style name="LightSettingsTheme" parent="LightTheme">
        <item name="colorAccent">@color/light_settings_accent_color</item>
        <item name="preferenceCategoryTitleTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="switchPreferenceCompatStyle">@style/Preference.MaterialSwitchPreferenceCompat</item>
    </style>

