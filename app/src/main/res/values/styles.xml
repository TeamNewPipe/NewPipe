        <item name="android:textColor">@color/yp_on_action</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/instrument_sans_semibold</item>
        <item name="android:minHeight">44dp</item>
        <item name="shapeAppearance">@style/YewPlayShape.Button</item>
        <item name="iconTint">@color/yp_on_action</item>
        <item name="iconSize">19dp</item>
    </style>

    <style name="YewPlayButton.Secondary">
        <item name="backgroundTint">@color/yp_surface_2</item>
        <item name="android:textColor">@color/yp_on_bg</item>
        <item name="iconTint">@color/yp_on_bg</item>
    </style>

    <style name="YewPlayAppCompatButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/yp_button_primary</item>
        <item name="android:textColor">@color/yp_on_action</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/instrument_sans_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingHorizontal">18dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="YewPlayAppCompatButton.Secondary">
        <item name="android:background">@drawable/yp_button_secondary</item>
        <item name="android:textColor">@color/yp_on_bg</item>
    </style>

    <style name="YewPlayShape.Button" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="YewPlayShape.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- YewPlay: miniatura em lista, 10dp de raio -->
    <style name="YewPlayShape.Thumbnail" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <!-- YewPlay: avatar de canal em quadrado arredondado (32% do lado) -->
    <style name="YewPlayShape.Avatar" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">32%</item>
    </style>

    <!-- YewPlay: capa de áudio e de playlist -->
    <style name="YewPlayShape.Cover" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
