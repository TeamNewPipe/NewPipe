        <item name="android:textColorPrimary">@color/yp_on_bg</item>
        <item name="android:textColorSecondary">@color/yp_muted</item>
        <item name="android:fontFamily">@font/yewplay_sans</item>
        <item name="fontFamily">@font/yewplay_sans</item>
    </style>

    <!-- YewPlay: diálogos e menus -->
    <style name="YewPlayAlertDialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="colorAccent">@color/yp_on_bg</item>
        <item name="android:windowBackground">@drawable/yp_dialog_background</item>
        <item name="android:textColorPrimary">@color/yp_on_bg</item>
        <item name="android:textColorSecondary">@color/yp_muted</item>
        <item name="android:fontFamily">@font/yewplay_sans</item>
        <item name="fontFamily">@font/yewplay_sans</item>
        <item name="buttonBarPositiveButtonStyle">@style/YewPlayDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/YewPlayDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/YewPlayDialogButton</item>
    </style>

    <style name="YewPlayDialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/yp_on_bg</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/instrument_sans_semibold</item>
    </style>

    <style name="YewPlayPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/yp_popup_background</item>
    </style>

    <style name="YewPlayOverflowMenu" parent="Widget.AppCompat.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/yp_popup_background</item>
    </style>

    <!-- YewPlay: título das barras em Bricolage Grotesque -->
    <style name="YewPlayToolbar" parent="Widget.AppCompat.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.YewPlay.ToolbarTitle</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.YewPlay.ToolbarSubtitle</item>
    </style>

    <style name="TextAppearance.YewPlay.ToolbarTitle" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:fontFamily">@font/bricolage_grotesque_bold</item>
        <item name="fontFamily">@font/bricolage_grotesque_bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">?attr/actionColor</item>
    </style>

    <style name="TextAppearance.YewPlay.ToolbarSubtitle" parent="TextAppearance.Widget.AppCompat.Toolbar.Subtitle">
        <item name="android:fontFamily">@font/instrument_sans_regular</item>
        <item name="fontFamily">@font/instrument_sans_regular</item>
        <item name="android:textColor">@color/yp_muted</item>
    </style>

    <!-- YewPlay: aviso com ação (fundo marfim/tinta, ação em negrito) -->
    <style name="YewPlaySnackbar" parent="Widget.MaterialComponents.Snackbar">
        <item name="backgroundTint">@color/yp_on_bg</item>
        <item name="shapeAppearance">@style/YewPlayShape.Medium</item>
        <item name="android:layout_margin">12dp</item>
    </style>

    <style name="YewPlaySnackbarText" parent="Widget.MaterialComponents.Snackbar.TextView">
        <item name="android:textColor">@color/yp_on_action</item>
        <item name="android:fontFamily">@font/instrument_sans_medium</item>
    </style>

    <style name="YewPlaySnackbarButton" parent="Widget.MaterialComponents.Button.TextButton.Snackbar">
        <item name="android:textColor">@color/yp_on_action</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/instrument_sans_bold</item>
    </style>

    <!-- YewPlay: abas em texto, sem caixa alta; a aba ativa ganha um traço rubi -->
    <style name="YewPlayTabs" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabTextAppearance">@style/TextAppearance.YewPlay.Tab</item>
        <item name="tabSelectedTextColor">@color/yp_on_bg</item>
        <item name="tabTextColor">@color/yp_muted</item>
        <item name="tabIndicatorColor">@color/yp_state</item>
        <item name="tabIndicator">@drawable/yp_tab_indicator</item>
        <item name="tabIndicatorFullWidth">false</item>
        <item name="tabIconTint">@color/yp_tab_icon</item>
        <item name="tabRippleColor">@color/light_ripple_color</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="TextAppearance.YewPlay.Tab" parent="TextAppearance.Design.Tab">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/instrument_sans_semibold</item>
        <item name="fontFamily">@font/instrument_sans_semibold</item>
    </style>

