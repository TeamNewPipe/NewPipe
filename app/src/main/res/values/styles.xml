<resources>

    <!-- Opening Theme -->
    <style name="Base.V21.OpeningTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@android:color/transparent</item>
        <item name="colorPrimaryDark">@android:color/transparent</item>
        <item name="colorAccent">@android:color/transparent</item>

        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
    <style name="Base.OpeningTheme" parent="Base.V21.OpeningTheme">
        <item name="android:navigationBarColor">@color/yewplay_splash_background</item>
        <item name="android:statusBarColor">@color/yewplay_splash_background</item>
    </style>
    <style name="OpeningTheme" parent="Base.OpeningTheme" />

    <!-- Base Theme -->
    <!-- YewPlay: barras na cor do fundo, marfim/tinta para ação, rubi só para estado.
         Instrument Sans em toda a interface. -->
    <style name="Base.V21" parent="Theme.MaterialComponents.DayNight.NoActionBar.Bridge">
        <item name="actionColor">@color/yp_on_bg</item>
        <item name="floatingActionButtonStyle">@style/FloatingActionButtonTheme</item>
        <item name="toolbarSearchColor">@color/yp_on_bg</item>
        <item name="colorControlActivated">?attr/colorAccent</item>
        <item name="colorControlNormal">@color/yp_muted</item>
        <item name="android:textColorPrimary">@color/yp_text_primary</item>
        <item name="android:textColorSecondary">@color/yp_text_secondary</item>
        <item name="android:textColorTertiary">@color/yp_muted</item>
        <item name="android:textColorLink">@color/yp_on_bg</item>
        <item name="android:textColorHighlight">#66E0364F</item>
        <item name="android:fontFamily">@font/yewplay_sans</item>
        <item name="fontFamily">@font/yewplay_sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">?attr/colorPrimaryDark</item>
        <item name="alertDialogTheme">@style/YewPlayAlertDialog</item>
        <item name="android:alertDialogTheme">@style/YewPlayAlertDialog</item>
        <item name="actionOverflowMenuStyle">@style/YewPlayOverflowMenu</item>
        <item name="popupMenuStyle">@style/YewPlayPopupMenu</item>
        <item name="toolbarStyle">@style/YewPlayToolbar</item>
        <item name="colorSurface">@color/yp_surface</item>
        <item name="colorOnSurface">@color/yp_on_bg</item>
        <item name="colorSecondary">@color/yp_on_bg</item>
        <item name="colorOnSecondary">@color/yp_on_action</item>
        <item name="colorOnPrimary">@color/yp_on_bg</item>
        <item name="snackbarStyle">@style/YewPlaySnackbar</item>
        <item name="snackbarButtonStyle">@style/YewPlaySnackbarButton</item>
        <item name="snackbarTextViewStyle">@style/YewPlaySnackbarText</item>
        <item name="tabStyle">@style/YewPlayTabs</item>
        <item name="materialButtonStyle">@style/YewPlayButton</item>
        <!-- mantém os widgets AppCompat; os componentes Material são usados só onde pedidos -->
        <item name="viewInflaterClass">androidx.appcompat.app.AppCompatViewInflater</item>
        <item name="buttonStyle">@style/YewPlayAppCompatButton</item>
        <item name="preferenceCategoryTitleTextColor">@color/yp_muted</item>
        <item name="preferenceCategoryTitleTextAppearance">@style/TextAppearance.YewPlay.PreferenceCategory</item>
        <item name="android:buttonStyle">@style/YewPlayAppCompatButton</item>
    </style>
    <style name="Base" parent="Base.V21"/>

    <!-- Light Theme -->
    <style name="Base.V21.LightTheme" parent="Base">
        <item name="colorPrimary">@color/yp_papel</item>
        <item name="colorPrimaryDark">@color/yp_papel</item>
        <item name="colorAccent">@color/yp_on_bg</item>
        <item name="android:windowBackground">@color/yp_papel</item>
        <item name="windowBackground">@color/yp_papel</item>
        <item name="android:colorBackground">@color/yp_papel</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="separator_color">@color/light_separator_color</item>
        <item name="contrast_background_color">@color/yp_papel_escuro</item>
        <item name="checked_selector">@drawable/selector_checked_light</item>
        <item name="focused_selector">@drawable/selector_focused_light</item>
        <item name="toolbar_shadow">@drawable/toolbar_shadow_light</item>
        <item name="selector">@drawable/selector_light</item>
        <item name="colorControlHighlight">@color/light_ripple_color</item>
        <item name="progress_horizontal_drawable">@drawable/progress_youtube_horizontal_light</item>
        <item name="card_item_background_color">@color/yp_papel_escuro</item>
        <item name="card_item_contrast_color">@color/yp_areia</item>
        <item name="border_color">@color/light_border_color</item>
        <item name="dashed_border">@drawable/dashed_border_light</item>
    </style>
    <style name="Base.LightTheme" parent="Base.V21.LightTheme" />
    <style name="LightTheme" parent="Base.LightTheme"/>

    <!-- Dark Theme -->
    <style name="Base.V21.DarkTheme" parent="Base">
        <item name="colorPrimary">@color/yp_grafite</item>
        <item name="colorPrimaryDark">@color/yp_grafite</item>
        <item name="colorAccent">@color/yp_on_bg</item>
        <item name="android:windowBackground">@color/yp_grafite</item>
        <item name="windowBackground">@color/yp_grafite</item>
        <item name="android:colorBackground">@color/yp_grafite</item>

        <item name="separator_color">@color/dark_separator_color</item>
        <item name="contrast_background_color">@color/yp_grafite_claro</item>
        <item name="checked_selector">@drawable/selector_checked_dark</item>
        <item name="focused_selector">@drawable/selector_focused_dark</item>
        <item name="toolbar_shadow">@drawable/toolbar_shadow_dark</item>
        <item name="selector">@drawable/selector_dark</item>
        <item name="colorControlHighlight">@color/dark_ripple_color</item>
        <item name="progress_horizontal_drawable">@drawable/progress_youtube_horizontal_dark</item>
        <item name="card_item_background_color">@color/yp_grafite_claro</item>
        <item name="card_item_contrast_color">@color/yp_fumaca</item>
        <item name="border_color">@color/dark_border_color</item>
        <item name="dashed_border">@drawable/dashed_border_dark</item>
    </style>
    <style name="Base.DarkTheme" parent="Base.V21.DarkTheme" />
    <style name="DarkTheme" parent="Base.DarkTheme"/>

    <!-- Black Theme -->
    <!-- AMOLED: preto puro no lugar do grafite -->
    <style name="Base.V21.BlackTheme" parent="DarkTheme">
        <item name="colorPrimary">@color/yp_preto</item>
        <item name="colorPrimaryDark">@color/yp_preto</item>
        <item name="android:windowBackground">@color/black_background_color</item>
        <item name="windowBackground">@color/black_background_color</item>
        <item name="android:colorBackground">@color/black_background_color</item>

        <item name="separator_color">@color/black_separator_color</item>
        <item name="contrast_background_color">@color/black_contrast_background_color</item>

        <item name="card_item_background_color">@color/black_card_item_background_color</item>
        <item name="card_item_contrast_color">@color/black_card_item_contrast_color</item>
        <item name="border_color">@color/black_border_color</item>
        <item name="dashed_border">@drawable/dashed_border_black</item>
    </style>
    <style name="Base.BlackTheme" parent="Base.V21.BlackTheme" />
    <style name="BlackTheme" parent="Base.BlackTheme"/>

    <!-- Dialogs -->
    <style name="LightDialogTheme" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="colorPrimary">@color/yp_papel</item>
        <item name="colorPrimaryDark">@color/yp_papel</item>
        <item name="colorAccent">@color/yp_on_bg</item>
        <item name="android:windowBackground">@color/yp_papel</item>
        <item name="windowBackground">@color/yp_papel</item>
        <item name="android:textColorPrimary">@color/yp_on_bg</item>
        <item name="android:textColorSecondary">@color/yp_muted</item>
        <item name="android:fontFamily">@font/yewplay_sans</item>
        <item name="fontFamily">@font/yewplay_sans</item>
    </style>

    <style name="DarkDialogTheme" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="colorPrimary">@color/yp_grafite_claro</item>
        <item name="colorPrimaryDark">@color/yp_grafite_claro</item>
        <item name="colorAccent">@color/yp_on_bg</item>
        <item name="android:windowBackground">@color/yp_grafite_claro</item>
        <item name="windowBackground">@color/yp_grafite_claro</item>
        <item name="android:textColorPrimary">@color/yp_on_bg</item>
        <item name="android:textColorSecondary">@color/yp_muted</item>
        <item name="android:fontFamily">@font/yewplay_sans</item>
        <item name="fontFamily">@font/yewplay_sans</item>
    </style>

    <style name="LightDialogMinWidthTheme" parent="Theme.AppCompat.DayNight.Dialog.MinWidth">
        <item name="colorPrimary">@color/yp_papel</item>
        <item name="colorPrimaryDark">@color/yp_papel</item>
        <item name="colorAccent">@color/yp_on_bg</item>
        <item name="android:windowBackground">@color/yp_papel</item>
        <item name="windowBackground">@color/yp_papel</item>
        <item name="android:textColorPrimary">@color/yp_on_bg</item>
        <item name="android:textColorSecondary">@color/yp_muted</item>
        <item name="android:fontFamily">@font/yewplay_sans</item>
        <item name="fontFamily">@font/yewplay_sans</item>
    </style>

    <style name="DarkDialogMinWidthTheme" parent="Theme.AppCompat.DayNight.Dialog.MinWidth">
        <item name="colorPrimary">@color/yp_grafite_claro</item>
        <item name="colorPrimaryDark">@color/yp_grafite_claro</item>
        <item name="colorAccent">@color/yp_on_bg</item>
        <item name="android:windowBackground">@color/yp_grafite_claro</item>
