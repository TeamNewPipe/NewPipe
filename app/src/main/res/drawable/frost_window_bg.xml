<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep near-solid dark page background (#0E0E14) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_page_bg" />
        </shape>
    </item>
    <!-- Soft low-saturation warm accent blob (accent red #E53935 at very low alpha) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.85"
                android:centerY="0.20"
                android:endColor="#00000000"
                android:gradientRadius="85%p"
                android:startColor="#18E53935"
                android:type="radial" />
        </shape>
    </item>
    <!-- Soft deep slate ambient blob at bottom -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.15"
                android:centerY="0.85"
                android:endColor="#00000000"
                android:gradientRadius="90%p"
                android:startColor="#18181E2E"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
