<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#06080F" />
        </shape>
    </item>
    <!-- warm glow, top left -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.05"
                android:centerY="0.05"
                android:endColor="#00000000"
                android:gradientRadius="85%p"
                android:startColor="#40E5395B"
                android:type="radial" />
        </shape>
    </item>
    <!-- cool glow, bottom right -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.95"
                android:centerY="0.92"
                android:endColor="#00000000"
                android:gradientRadius="90%p"
                android:startColor="#404B6BFF"
                android:type="radial" />
        </shape>
    </item>
    <!-- violet glow, right edge -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="1.0"
                android:centerY="0.45"
                android:endColor="#00000000"
                android:gradientRadius="60%p"
                android:startColor="#30A66BFF"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
