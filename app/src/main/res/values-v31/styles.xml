<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+ system splash screen.
         This is separate from android:windowBackground used by pre-Android 12 startup. -->
    <style name="OpeningTheme" parent="Base.OpeningTheme">
        <item name="android:windowSplashScreenBackground">@color/light_m3_secondary_container_color</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_newpipe_material_splash</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@color/light_m3_secondary_container_color</item>
        <item name="android:navigationBarColor">@color/light_m3_secondary_container_color</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
